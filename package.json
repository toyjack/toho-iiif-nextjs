{
  "name": "toho-iiif-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "data": "bun scripts/build-data.ts",
    "dev": "bun run data && bun --bun next dev",
    "build": "bun run data && bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "bun run data && tsc --noEmit",
    "test": "bun run data && bun test",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tify": "^0.36.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.0.43",
    "eslint": "9",
    "eslint-config-next": "16.4.5",
    "pinyin-pro": "3.29.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "4.1.12"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
